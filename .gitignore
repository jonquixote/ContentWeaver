# MOSS-TTS microservice: source clone + downloaded ONNX weights stay out of git
# (weights ~728MB lazy-download at runtime; plan global constraint: never store
# raw reference audio or model weights in git).
money_weaver_backend/tts_service/MOSS-TTS-Nano/
money_weaver_backend/tts_service/models/
money_weaver_backend/tts_service/generated_audio/

# Music bed audio is licensed per-install (CC0/Pixabay/FreePD); only
# music/manifest.yaml + README ship in git. See money_weaver_backend/music/README.md.
money_weaver_backend/music/*.[mM][pP]3
money_weaver_backend/music/*.[wW][aA][vV]
money_weaver_backend/music/*.[oO][gG][gG]
money_weaver_backend/music/*.[mM]4[aA]
