DATABASE_URL="sqlite:////Volumes/JOHNNY DISK/MoneyWeaver/money_weaver_backend/src/database/app.db"
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=change-me-to-a-long-random-string
LITELLM_PROXY_URL=http://localhost:8000
LITELLM_MASTER_KEY=sk-master-key-change-me
GROQ_API_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=
MINIO_ROOT_USER=minioadmin-change-me
MINIO_ROOT_PASSWORD=minioadmin-change-me
POSTGRES_USER=money_weaver
POSTGRES_PASSWORD=money_weaver_password_change_me
POSTGRES_DB=money_weaver
MINIO_ACCESS_KEY=minioadmin-change-me
MINIO_SECRET_KEY=minioadmin-change-me

# Storage backend (local | s3 | minio | r2). Defaults to local.
STORAGE_BACKEND=local
# Base URL of the API server, used to build absolute backend-relative media URLs.
STORAGE_BACKEND_URL=http://localhost:5004
# Object storage endpoint (S3/R2/MinIO); ignored for local backend.
STORAGE_ENDPOINT=http://localhost:9000
# Access key for S3/R2/MinIO (placeholder, set your own).
STORAGE_ACCESS_KEY=minioadmin-change-me
# Secret key for S3/R2/MinIO (placeholder, set your own).
STORAGE_SECRET_KEY=minioadmin-change-me
# Object storage bucket name.
STORAGE_BUCKET=moneyweaver
# Object storage region (use 'auto' for R2).
STORAGE_REGION=auto
# Local directory where files land when STORAGE_BACKEND=local.
STORAGE_LOCAL_DIR=uploads

# ------------------------------------------
# Cinema engine (Plan A) — all heavy/optional
# features default OFF so the test suite passes
# with them absent. Enable gradually.
# ------------------------------------------
CINEMA_ENABLED=false
CINEMA_DIRECTOR_ENABLED=false
CINEMA_DIRECTOR_TIMEOUT_S=8
CINEMA_DIRECTOR_MODEL=            # default: SCRIPT_MODEL or gpt-4o-mini
CINEMA_ASL_BASE=2.5
CINEMA_DEDUP_HAMMING=6
CINEMA_CACHE_DIR=/tmp/cw-cinema-cache

# ------------------------------------------
# Footage ingest (Plan B) — all heavy/optional
# default OFF. Tests pass with these absent.
# ------------------------------------------
VECTOR_STORE=sqlite_vec
EMBED_BACKEND=none
EMBED_MODEL=ViT-B-32
EMBED_BACKEND_L_MODEL=ViT-L-14
USE_SCENEDETECT=false
ENABLE_BLIP=false
FOOTAGE_SOURCES_ENABLED=pexels,pixabay,coverr,archive_org,nasa_images,loc,wikimedia_commons,open_images
FOOTAGE_MANUAL_IMPORT_DIR=footage/imports
FOOTAGE_MAX_DURATION_S=120
FOOTAGE_QUEUE=footage
FOOTAGE_DISK_RETENTION_H=1
FOOTAGE_WORK_DIR=work
FOOTAGE_VECTOR_DB=/tmp/cw-footage-vec.db
FOOTAGE_LIVE_FALLBACK_THRESHOLD=3
FOOTAGE_CREDITS_ENABLED=false

# ------------------------------------------
# Cinema edit timing (Plan D) — all default
# OFF so the suite passes absent.
# ------------------------------------------
CINEMA_TIMING_ENABLED=false
CINEMA_CUT_ON_ACTION=true
CINEMA_CUT_WINDOW_S=0.5
CINEMA_JL_CUT_S=0.4
USE_TRANSNET=false
USE_LIBROSA_BEATS=false
