# MOSS-TTS inference service (FastAPI, ONNX CPU, port 8001).
# Runs in its OWN venv (tts_service/.venv, python 3.12). Never installed into main venv.
MOSS_TTS_HOST=0.0.0.0
MOSS_TTS_PORT=8001
# Local clone of the MOSS-TTS-Nano source repo (git-ignored; created by setup).
MOSS_TTS_REPO=./MOSS-TTS-Nano
# ONNX model dir. Weights (~728MB) lazy-download here on first /tts.
# Leave unset to use <MOSS_TTS_REPO>/models.
# MOSS_TTS_MODEL_DIR=./models
# ONNX intra-op thread count (CPU).
MOSS_TTS_THREADS=4
# Output sample rate the service returns (MOSS native output is 48kHz stereo;
# the service downmixes to mono at this rate to match the Kokoro pipeline).
# MOSS_TTS_SAMPLE_RATE=24000